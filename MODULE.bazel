module(
    name = "terraform_provider_firehydrant",
    version = "0.0.0",
)

bazel_dep(name = "aspect_bazel_lib", version = "2.13.0")
bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "gazelle", version = "0.40.0", repo_name = "bazel_gazelle")
bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "rules_go", version = "0.53.0", repo_name = "io_bazel_rules_go")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    version = "1.24.2",
)

go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_bxcodec_faker_v3",
    "com_github_davecgh_go_spew",
    "com_github_dghubble_sling",
    "com_github_firehydrant_firehydrant_go_sdk",
    "com_github_google_go_querystring",
    "com_github_hashicorp_go_cty",
    "com_github_hashicorp_terraform_plugin_log",
    "com_github_hashicorp_terraform_plugin_sdk_v2",
    "com_github_pkg_errors",
    "com_github_senseyeio_duration",
    "com_github_stretchr_testify",
)
