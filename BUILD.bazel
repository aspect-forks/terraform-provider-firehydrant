load("@bazel_gazelle//:def.bzl", "gazelle")
load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel/release:multi_platform_go_binaries.bzl", "multi_platform_go_binaries")

# gazelle:prefix github.com/firehydrant/terraform-provider-firehydrant
# gazelle:build_file_name BUILD.bazel
# gazelle:go_naming_convention import
# gazelle:go_naming_convention_external import
# gazelle:exclude **/testdata
# gazelle:exclude examples/**
# gazelle:exclude docs/**
# gazelle:exclude local/**
# gazelle:exclude contributing/**
# gazelle:exclude scripts/**

gazelle(name = "gazelle")

gazelle(
    name = "gazelle.check",
    mode = "diff",
)

go_library(
    name = "terraform-provider-firehydrant_lib",
    srcs = ["main.go"],
    importpath = "github.com/firehydrant/terraform-provider-firehydrant",
    visibility = ["//visibility:private"],
    deps = [
        "//provider",
        "@com_github_hashicorp_terraform_plugin_sdk_v2//helper/schema",
        "@com_github_hashicorp_terraform_plugin_sdk_v2//plugin",
    ],
)

go_binary(
    name = "terraform-provider-firehydrant",
    embed = [":terraform-provider-firehydrant_lib"],
    visibility = ["//visibility:public"],
)

multi_platform_go_binaries(
    name = "release",
    embed = [":terraform-provider-firehydrant_lib"],
    visibility = ["//visibility:public"],
)
